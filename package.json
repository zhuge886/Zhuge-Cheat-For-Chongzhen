{
  "name": "zhuge-cheat-for-chongzhen",
  "version": "0.1.0",
  "description": "Windows GUI BYOK proxy for 历史模拟器：崇祯 with configurable prompt capture and conditional override keyword.",
  "main": "src/main.js",
  "author": "zhuge886",
  "private": false,
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/proxy.js && node --check src/config-manager.js && node --check src/rule-engine.js && node --check src/renderer/renderer.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.zhuge.chongzhen.byokproxy",
    "productName": "Zhuge Cheat for Chongzhen",
    "artifactName": "Zhuge-Cheat-For-Chongzhen-${version}-${arch}.${ext}",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
